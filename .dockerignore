# AISliDev .dockerignore
# Optimize container build by excluding unnecessary files

# Version control
.git
.gitignore
.gitattributes

# Dependencies (will be installed in container)
node_modules

# Build artifacts (will be built in container)
dist

# Development files
.vscode
.idea
*.swp
*.swo
*~

# Testing
coverage
.nyc_output

# Environment files (use .env.example and configure at runtime)
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in container)
docs
*.md
!README.md

# CI/CD
.github
.gitlab-ci.yml

# Temporary files
tmp
temp
*.tmp

# Local development data (exclude data dir, but keep data/themes)
!data/themes
storage
test-slidev

# AI and development tools
.ai
.claude
.roo
.opencode
.opencodeignore
.notes
.template

# Pre-commit hooks
.pre-commit-config.yaml

# Config examples (keep actual config)
*.example
config.toml.example
.env.example

# Editor config (useful in development but not in container)
.editorconfig

# Archive files
ARCHIVE_*.md
