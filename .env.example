# ============================================
# AISliDev Production Configuration
# ============================================
# Copy this file to .env and customize as needed
# 複製此檔案為 .env 並根據需要自訂

# Server Configuration
# 伺服器配置
PORT=13000
HOST=0.0.0.0

# Auto Port Selection
# 自動 Port 選擇
# Set to 'false' to disable automatic port selection (production/strict mode)
# 設為 'false' 停用自動 port 選擇（生產環境/嚴格模式）
# Default: true (enabled for development convenience)
# 預設：true（開發環境方便使用）
AUTO_PORT_SELECTION=true

# Logging
# 日誌
LOG_LEVEL=info

# Development
# 開發模式
NODE_ENV=development

# Note: If PORT is already in use, the server will automatically
# try to find the next available port (3001, 3002, etc.)
# 註：如果 PORT 已被佔用，伺服器會自動嘗試找下一個可用的 port（3001, 3002 等）

# ============================================
# Optional: Additional Configuration Examples
# (from scaffolding template - all commented)
# ============================================

# Example: Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=your_database
# DB_USER=your_username
# DB_PASSWORD=your_password

# Example: API Keys (NEVER put real keys here)
# API_KEY=your_api_key_here
# SECRET_KEY=your_secret_key_here
# OPENAI_API_KEY=sk-...

# Example: Application Settings
# APP_ENV=development
# DEBUG=true

# Example: Third-party Services
# STRIPE_API_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-west-2

# Example: Authentication
# JWT_SECRET=your_jwt_secret_here
# SESSION_SECRET=your_session_secret_here
# OAUTH_CLIENT_ID=...
# OAUTH_CLIENT_SECRET=...
