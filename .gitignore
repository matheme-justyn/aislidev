# Environment variables
.env
.env.local
.env.production

# Node modules
node_modules/
*/node_modules/

# Build outputs
dist/
build/
*/dist/
*/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Uploads and temporary files
backend/uploads/*
!backend/uploads/.gitkeep
backend/exports/*
!backend/exports/.gitkeep
backend/temp/*
!backend/temp/.gitkeep

# Database
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# SSL certificates
ssl/*.pem
ssl/*.key
ssl/*.crt

# Docker/Podman
*.pid
.dockerignore

# Prisma
backend/prisma/migrations/

# System Files
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Test directories (temporary exploration)
test-slidev/

# Application data
data/

# Personal notes (AI-generated best practices notes)
# Only AI_INSTRUCTIONS.md and docs-list.sample.md are tracked
.notes/*
!.notes/AI_INSTRUCTIONS.md
!.notes/docs-list.sample.md
storage/
